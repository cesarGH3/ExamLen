# ExamLen - archivo externo de secretos (nunca versionar el archivo real).
# Copia este archivo como {catalina.base}/conf/examlen-secrets.properties
# o indica otra ruta con EXAMLEN_SECRETS_FILE / -Dexamlen.secrets.file.
#
# Los valores deben ser largos y aleatorios. No reutilices secretos de otros sistemas.
# En produccion la aplicacion falla al arrancar si falta api.token.secret.

api.token.secret=CAMBIA_ESTE_SECRETO_LARGO
order.secret=CAMBIA_ESTE_SECRETO_LARGO

# Solo durante la instalacion inicial; retirar despues del primer administrador.
bootstrap.secret=CAMBIA_ESTE_SECRETO_LARGO

# Clave AES-GCM para las claves de IA de los docentes, en Base64 (16, 24 o 32 bytes).
# Conserva la misma clave que ya tuviera el despliegue para no invalidar valores cifrados.
#ia.crypto.key=CAMBIAR_CLAVE_BASE64
