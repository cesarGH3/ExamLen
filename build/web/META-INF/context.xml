<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plantilla del recurso JNDI jdbc/ExamLenDB (copia de despliegue; no versionable).
  No contiene credenciales: define examlen.db.url, examlen.db.user y
  examlen.db.password al final de {Catalina Base}/conf/catalina.properties.
  La URL debe conservar connectionTimeZone=America/Bogota y
  sessionVariables=time_zone='-05:00' (RNF-15).
-->
<Context path="/ExamLen">
  <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" sameSiteCookies="strict"/>
  <Resource auth="Container" driverClassName="com.mysql.cj.jdbc.Driver" maxIdle="5" maxTotal="20" maxWaitMillis="3000" minIdle="0" name="jdbc/ExamLenDB" password="${examlen.db.password}" removeAbandonedOnBorrow="true" removeAbandonedTimeout="60" testOnBorrow="true" type="javax.sql.DataSource" url="${examlen.db.url}" username="${examlen.db.user}" validationQuery="SELECT 1" validationQueryTimeout="2"/>
</Context>
